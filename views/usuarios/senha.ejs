<%- include('../partials/header', { usuario, paginaAtiva: 'senha' , titulo: 'Trocar Senha' }) %>

    <div class="page-header">
        <h2>Trocar minha senha</h2>
    </div>

    <% if (erro) { %>
        <div class="erro">
            <%= erro %>
        </div>
        <% } %>
            <% if (sucesso) { %>
                <div class="sucesso">
                    <%= sucesso %>
                </div>
                <% } %>

                    <form method="POST" action="/usuarios/senha" class="form-card">
                        <label>Senha atual *</label>
                        <input type="password" name="senha_atual" required>

                        <label>Nova senha *</label>
                        <input type="password" name="senha_nova" minlength="6" required>

                        <label>Confirmar nova senha *</label>
                        <input type="password" name="senha_confirma" minlength="6" required>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Alterar senha</button>
                        </div>
                    </form>

                    <%- include('../partials/footer') %>