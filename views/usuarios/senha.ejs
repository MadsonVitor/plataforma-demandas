<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Trocar Senha</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header class="topbar">
        <h1>Central de Demandas</h1>
        <div class="user-info">
            <a href="/demandas" class="btn-sair" style="background:#475569">Demandas</a>
            <span>Olá, <strong>
                    <%= usuario.nome %>
                </strong></span>
            <a href="/logout" class="btn-sair">Sair</a>
        </div>
    </header>

    <main class="container narrow">
        <div class="page-header">
            <h2>Trocar minha senha</h2>
            <a href="/demandas" class="btn btn-ghost">← Voltar</a>
        </div>

        <% if (erro) { %>
            <div class="erro">
                <%= erro %>
            </div>
            <% } %>
                <% if (sucesso) { %>
                    <div class="sucesso">
                        <%= sucesso %>
                    </div>
                    <% } %>

                        <form method="POST" action="/usuarios/senha" class="form-card">
                            <label>Senha atual *</label>
                            <input type="password" name="senha_atual" required>

                            <label>Nova senha *</label>
                            <input type="password" name="senha_nova" minlength="6" required>

                            <label>Confirmar nova senha *</label>
                            <input type="password" name="senha_confirma" minlength="6" required>

                            <div class="form-actions">
                                <button type="submit" class="btn btn-primary">Alterar senha</button>
                            </div>
                        </form>
    </main>
</body>

</html>