<%- include('../partials/header', { usuario, paginaAtiva: 'usuarios' , titulo: 'Usuários - Central' }) %>

    <div class="page-header">
        <h2>Usuários</h2>
        <a href="/usuarios/novo" class="btn btn-primary">+ Novo usuário</a>
    </div>

    <% if (erro) { %>
        <div class="erro">
            <%= erro %>
        </div>
        <% } %>
            <% if (sucesso) { %>
                <div class="sucesso">
                    <%= sucesso %>
                </div>
                <% } %>

                    <table class="tabela">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>E-mail</th>
                                <th>Perfil</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% usuarios.forEach(u=> { %>
                                <tr>
                                    <td>
                                        <%= u.id %>
                                    </td>
                                    <td>
                                        <%= u.nome %>
                                    </td>
                                    <td>
                                        <%= u.email %>
                                    </td>
                                    <td><span class="badge prio-<%= u.perfil === 'supervisor' ? 'alta' : 'media' %>">
                                            <%= u.perfil %>
                                        </span></td>
                                    <td>
                                        <% if (u.ativo) { %>
                                            <span class="badge status-concluido">ativo</span>
                                            <% } else { %>
                                                <span class="badge status-pendente">inativo</span>
                                                <% } %>
                                    </td>
                                    <td>
                                        <% if (u.id !==usuario.id) { %>
                                            <form method="POST" action="/usuarios/<%= u.id %>/ativo"
                                                style="display:inline">
                                                <button class="btn btn-small" type="submit">
                                                    <%= u.ativo ? 'Desativar' : 'Ativar' %>
                                                </button>
                                            </form>
                                            <% } else { %>
                                                <span class="obs-data">(você)</span>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>

                    <%- include('../partials/footer') %>