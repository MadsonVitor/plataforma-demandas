<%- include('../partials/header', { usuario, paginaAtiva: 'dashboard' , titulo: 'Dashboard - Central' }) %>

    <div class="page-header">
        <h2>Dashboard</h2>
    </div>

    <% if (totais.alta_prioridade_pendente> 0) { %>
        <div class="alerta-urgente">
            <strong>
                <%= totais.alta_prioridade_pendente %>
            </strong> demanda<%= totais.alta_prioridade_pendente> 1 ? 's' : '' %> de <strong>alta prioridade</strong>
                ainda em aberto.
                <a href="/demandas?prioridade=alta">Ver agora</a>
        </div>
        <% } %>

            <div class="stats grid-4">
                <a href="/demandas" class="stat">
                    <span class="num">
                        <%= totais.total %>
                    </span>
                    <span class="lbl">Total de demandas</span>
                </a>
                <a href="/demandas?status=pendente" class="stat pendente">
                    <span class="num">
                        <%= totais.pendente %>
                    </span>
                    <span class="lbl">Pendentes</span>
                </a>
                <a href="/demandas?status=em_andamento" class="stat andamento">
                    <span class="num">
                        <%= totais.em_andamento %>
                    </span>
                    <span class="lbl">Em andamento</span>
                </a>
                <a href="/demandas?status=concluido" class="stat concluido">
                    <span class="num">
                        <%= totais.concluido %>
                    </span>
                    <span class="lbl">Concluídas</span>
                </a>
            </div>

            <div class="dashboard-grid">
                <section class="card">
                    <h3>Alta prioridade em aberto</h3>
                    <% if (urgentes.length===0) { %>
                        <p class="vazio-mini">Nada urgente por aqui.</p>
                        <% } else { %>
                            <ul class="lista-simples">
                                <% urgentes.forEach(u=> { %>
                                    <li>
                                        <a href="/demandas/<%= u.id %>"><strong>#<%= u.id %></strong>
                                            <%= u.titulo %>
                                        </a>
                                        <div class="meta">
                                            <span>
                                                <%= u.cliente_nome %>
                                            </span>
                                            <span class="badge status-<%= u.status %>">
                                                <%= u.status.replace('_',' ') %></span>
              <span class="responsavel"><%= u.responsavel_nome || ' sem responsável' %>
                                            </span>
                                        </div>
                                    </li>
                                    <% }) %>
                            </ul>
                            <% } %>
                </section>

                <section class="card">
                    <h3>Paradas há mais de 3 dias</h3>
                    <% if (paradas.length===0) { %>
                        <p class="vazio-mini">Nenhuma demanda parada.</p>
                        <% } else { %>
                            <ul class="lista-simples">
                                <% paradas.forEach(p=> { %>
                                    <li>
                                        <a href="/demandas/<%= p.id %>"><strong>#<%= p.id %></strong>
                                            <%= p.titulo %>
                                        </a>
                                        <div class="meta">
                                            <span>
                                                <%= p.cliente_nome %>
                                            </span>
                                            <span class="badge prio-<%= p.prioridade %>">
                                                <%= p.prioridade %>
                                            </span>
                                            <span class="dias-parada">
                                                <%= p.dias_parada %> dias parada
                                            </span>
                                        </div>
                                    </li>
                                    <% }) %>
                            </ul>
                            <% } %>
                </section>
            </div>

            <section class="card">
                <h3>Últimas demandas criadas</h3>
                <% if (recentesGrupos.length===0) { %>
                    <p class="vazio-mini">Nenhuma demanda cadastrada ainda.</p>
                    <% } else { %>
                        <% recentesGrupos.forEach(grupo=> { %>
                            <div class="bloco-dia">
                                <h4 class="bloco-dia-titulo">
                                    <%= grupo.titulo %>
                                        <span class="bloco-dia-count">
                                            <%= grupo.itens.length %>
                                        </span>
                                </h4>
                                <ul class="lista-demandas">
                                    <% grupo.itens.forEach(d=> { %>
                                        <li class="item-demanda">
                                            <span class="item-hora">
                                                <%= d.hora %>
                                            </span>
                                            <span class="item-id">#<%= d.id %></span>
                                            <span class="item-cliente">
                                                <%= d.cliente_nome %>
                                            </span>
                                            <span class="item-titulo">
                                                <%= d.titulo %>
                                            </span>
                                            <span class="badge prio-<%= d.prioridade %>">
                                                <%= d.prioridade %>
                                            </span>
                                            <span class="badge status-<%= d.status %>">
                                                <%= d.status.replace('_',' ') %></span>
              <span class="item-responsavel"><%= d.responsavel_nome || ' —' %>
                                            </span>
                                            <a href="/demandas/<%= d.id %>" class="btn btn-small">Abrir</a>
                                        </li>
                                        <% }) %>
                                </ul>
                            </div>
                            <% }) %>
                                <% } %>
            </section>

            <%- include('../partials/footer') %>