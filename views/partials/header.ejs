<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= titulo || 'Central de Demandas' %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header class="topbar">
        <div class="topbar-logo">
            <button>Central de Demandas</button>
        </div>
        <div class="topbar-user">
            <span class="topbar-nome">
                <%= usuario.nome %>
            </span>
            <span class="topbar-perfil">
                <%= usuario.perfil %>
            </span>
            <a href="/logout" class="topbar-sair">Sair</a>
        </div>
    </header>

    <div class="layout">
        <aside class="sidebar">

            <% if (usuario.perfil==='supervisor' ) { %>
                <a href="/demandas/nova" class="sidebar-compose">
                    <span class="sidebar-compose-icon">+</span>
                    Nova demanda
                </a>
                <% } %>

                    <nav class="sidebar-nav">
                        <a href="/dashboard" class="sidebar-item <%= paginaAtiva === 'dashboard' ? 'ativo' : '' %>">
                            Dashboard
                        </a>
                        <a href="/demandas" class="sidebar-item <%= paginaAtiva === 'demandas' ? 'ativo' : '' %>">
                            Demandas
                        </a>
                        <a href="/demandas/calendario"
                            class="sidebar-item <%= paginaAtiva === 'calendario' ? 'ativo' : '' %>">
                            Calendário
                        </a>
                        <% if (usuario.perfil==='supervisor' ) { %>
                            <a href="/usuarios" class="sidebar-item <%= paginaAtiva === 'usuarios' ? 'ativo' : '' %>">
                                Usuários
                            </a>
                            <% } %>
                                <a href="/usuarios/senha"
                                    class="sidebar-item <%= paginaAtiva === 'senha' ? 'ativo' : '' %>">
                                    Minha senha
                                </a>
                    </nav>
        </aside>

        <main class="content">
            <div class="content-card">