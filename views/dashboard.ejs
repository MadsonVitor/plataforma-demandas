<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Dashboard - Central de Demandas</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header class="topbar">
        <h1>Central de Demandas</h1>
        <div class="user-info">
            <span>Olá, <strong>
                    <%= usuario.nome %>
                </strong> (<%= usuario.perfil %>)</span>
            <a href="/logout" class="btn-sair">Sair</a>
        </div>
    </header>

    <main class="container">
        <h2>Dashboard</h2>
        <p>Em breve: lista de demandas, cadastro, filtros e status. 🚧</p>
    </main>
</body>

</html>