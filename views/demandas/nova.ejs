<%- include('../partials/header', { usuario, paginaAtiva: 'demandas' , titulo: 'Nova Demanda' }) %>

    <div class="page-header">
        <h2>Nova Demanda</h2>
        <a href="/demandas" class="btn btn-ghost">Voltar</a>
    </div>

    <% if (erro) { %>
        <div class="erro">
            <%= erro %>
        </div>
        <% } %>

            <form method="POST" action="/demandas/nova" class="form-card">
                <label>Cliente existente</label>
                <select name="cliente_id">
                    <option value="">Selecione</option>
                    <% clientes.forEach(c=> { %>
                        <option value="<%= c.id %>">
                            <%= c.nome %>
                        </option>
                        <% }) %>
                </select>

                <label>Ou cadastre um novo cliente</label>
                <input type="text" name="novo_cliente" placeholder="Nome do novo cliente (opcional)">

                <label>Título da demanda *</label>
                <input type="text" name="titulo" required>

                <label>Descrição</label>
                <textarea name="descricao" rows="4"></textarea>

                <label>Prioridade</label>
                <select name="prioridade">
                    <option value="baixa">Baixa</option>
                    <option value="media" selected>Média</option>
                    <option value="alta">Alta</option>
                </select>

                <label>Responsável (opcional)</label>
                <select name="responsavel_id">
                    <option value="">Ninguém ainda</option>
                    <% funcionarios.forEach(f=> { %>
                        <option value="<%= f.id %>">
                            <%= f.nome %>
                        </option>
                        <% }) %>
                </select>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Cadastrar demanda</button>
                    <a href="/demandas" class="btn btn-ghost">Cancelar</a>
                </div>
            </form>

            <%- include('../partials/footer') %>