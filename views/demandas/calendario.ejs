<%- include('../partials/header', { usuario, paginaAtiva: 'calendario' , titulo: 'Calendário - Central' }) %>

    <div class="page-header">
        <h2>Demandas</h2>
    </div>

    <div class="calendario-nav">
        <a href="/demandas/calendario?mes=<%= mesAnterior %>" class="btn btn-ghost">← Mês anterior</a>
        <h3>
            <%= nomeMes %>
        </h3>
        <a href="/demandas/calendario?mes=<%= mesProximo %>" class="btn btn-ghost">Próximo mês →</a>
    </div>

    <div class="calendario-legenda">
        <span class="legenda-item"><span class="dot dot-criada"></span> Criadas</span>
        <span class="legenda-item"><span class="dot dot-atualizada"></span> Atualizadas</span>
        <span class="legenda-item"><span class="dot dot-excluida"></span> Excluídas</span>
    </div>

    <div class="calendario">
        <div class="calendario-header">
            <div>Dom</div>
            <div>Seg</div>
            <div>Ter</div>
            <div>Qua</div>
            <div>Qui</div>
            <div>Sex</div>
            <div>Sáb</div>
        </div>

        <div class="calendario-grid">
            <% for (let i=0; i < diaSemanaInicio; i++) { %>
                <div class="calendario-dia vazio"></div>
                <% } %>

                    <% for (let dia=1; dia <=diasNoMes; dia++) { const diaStr=String(dia).padStart(2, '0' ); const
                        chave=`${ano}-${String(numMes).padStart(2, '0' )}-${diaStr}`; const atividades=porDia[chave] ||
                        []; const criadas=atividades.filter(a=> a.tipo === 'demanda_criada').length;
                        const atualizadas = atividades.filter(a =>
                        ['status_alterado','responsavel_atribuido','observacao_adicionada','demanda_editada'].includes(a.tipo)).length;
                        const excluidas = atividades.filter(a => a.tipo === 'demanda_excluida').length;
                        const hoje = new Date();
                        const ehHoje = hoje.getFullYear() === ano && (hoje.getMonth() + 1) === numMes && hoje.getDate()
                        === dia;
                        const selecionado = diaSelecionado === chave;
                        %>
                        <a href="/demandas/calendario?mes=<%= mes %>&dia=<%= chave %>"
                            class="calendario-dia <%= ehHoje ? 'hoje' : '' %> <%= selecionado ? 'selecionado' : '' %> <%= atividades.length > 0 ? 'tem-atividade' : '' %>">
                            <span class="dia-numero">
                                <%= dia %>
                            </span>
                            <div class="dia-dots">
                                <% if (criadas> 0) { %><span class="dot dot-criada"></span>
                                    <% } %>
                                        <% if (atualizadas> 0) { %><span class="dot dot-atualizada"></span>
                                            <% } %>
                                                <% if (excluidas> 0) { %><span class="dot dot-excluida"></span>
                                                    <% } %>
                            </div>
                            <% if (atividades.length> 0) { %>
                                <span class="dia-count">
                                    <%= atividades.length %>
                                </span>
                                <% } %>
                        </a>
                        <% } %>
        </div>
    </div>

    <% if (diaSelecionado && atividadesDoDia.length> 0) { %>
        <section class="card card-dia">
            <h3>📌 Atividades de <%= diaSelecionado.split('-').reverse().join('/') %>
            </h3>
            <ul class="lista-atividades">
                <% atividadesDoDia.forEach(a=> { %>
                    <li class="atividade-item">
                        <span class="atividade-hora">
                            <%= a.hora || '—' %>
                        </span>
                        <span class="atividade-tipo badge-tipo tipo-<%= a.tipo %>">
                            <%= a.tipo.replace('_', ' ' ) %>
                        </span>
                        <span class="atividade-desc">
                            <%= a.descricao || '—' %>
                        </span>
                        <span class="atividade-user">por <strong>
                                <%= a.usuario_nome %>
                            </strong></span>
                        <% if (a.demanda_id) { %>
                            <a href="/demandas/<%= a.demanda_id %>" class="btn btn-small">Ver #<%= a.demanda_id %></a>
                            <% } %>
                    </li>
                    <% }) %>
            </ul>
        </section>
        <% } else if (diaSelecionado) { %>
            <section class="card">
                <p class="vazio-mini">Nenhuma atividade registrada nesse dia.</p>
            </section>
            <% } %>

                <%- include('../partials/footer') %>