<%- include('../partials/header', { usuario, paginaAtiva: 'demandas' , titulo: 'Demanda #' + demanda.id }) %>

    <div class="page-header">
        <h2>Demanda #<%= demanda.id %>
        </h2>
        <div class="page-header-acoes">
            <button type="button" class="btn btn-ghost" id="btn-historico">Histórico</button>
            <% if (usuario.perfil==='supervisor' ) { %>
                <a href="/demandas/<%= demanda.id %>/editar" class="btn btn-primary">Editar</a>
                <% } %>
                    <a href="/demandas" class="btn btn-ghost">Voltar</a>
        </div>
    </div>

    <!-- Detalhes da demanda -->
    <div class="card">
        <div class="linha"><strong>Cliente:</strong> <span>
                <%= demanda.cliente_nome %>
            </span></div>
        <div class="linha"><strong>Título:</strong> <span>
                <%= demanda.titulo %>
            </span></div>
        <div class="linha"><strong>Descrição:</strong> <span>
                <%= demanda.descricao || '—' %>
            </span></div>
        <div class="linha">
            <strong>Prioridade:</strong>
            <span class="badge prio-<%= demanda.prioridade %>">
                <%= demanda.prioridade %>
            </span>
        </div>
        <div class="linha">
            <strong>Prazo:</strong>
            <% if (demanda.prazo) { %>
                <span>
                    <%= new Date(demanda.prazo + 'T00:00:00' ).toLocaleDateString('pt-BR') %>
                </span>
                <% } else { %>
                    <span class="sem-prazo">sem prazo</span>
                    <% } %>
        </div>
        <div class="linha">
            <strong>Criada por:</strong>
            <span>
                <%= demanda.criador_nome %> em <%= demanda.criado_em %>
            </span>
        </div>
    </div>

    <!-- Status e Responsável lado a lado -->
    <div class="card-2col">
        <div class="card">
            <h3>Status</h3>
            <form method="POST" action="/demandas/<%= demanda.id %>/status" class="inline-form">
                <select name="status">
                    <option value="pendente" <%=demanda.status==='pendente' ? 'selected' : '' %>>Pendente</option>
                    <option value="em_andamento" <%=demanda.status==='em_andamento' ? 'selected' : '' %>>Em andamento
                    </option>
                    <option value="concluido" <%=demanda.status==='concluido' ? 'selected' : '' %>>Concluído</option>
                </select>
                <button class="btn btn-primary" type="submit">Atualizar</button>
                <span class="badge status-<%= demanda.status %>">
                    <%= demanda.status.replace('_',' ') %></span>
    </form>
  </div>

  <div class="card">
    <h3>Responsável</h3>
    <% if (usuario.perfil === ' supervisor') { %>
                        <form method="POST" action="/demandas/<%= demanda.id %>/responsavel" class="inline-form">
                            <select name="responsavel_id">
                                <option value="">Ninguém</option>
                                <% funcionarios.forEach(f=> { %>
                                    <option value="<%= f.id %>" <%=demanda.responsavel_id===f.id ? 'selected' : '' %>>
                                        <%= f.nome %>
                                    </option>
                                    <% }) %>
                            </select>
                            <button class="btn btn-primary" type="submit">Salvar</button>
                        </form>
                        <% } else { %>
                            <p class="valor-responsavel">
                                <%= demanda.responsavel_nome || 'Ninguém' %>
                            </p>
                            <% } %>
        </div>
    </div>

    <!-- Observações + Anexos unificados -->
    <div class="card">
        <h3>Observações e Anexos</h3>

        <form method="POST" action="/demandas/<%= demanda.id %>/observacao" enctype="multipart/form-data"
            class="form-obs-unificado">
            <textarea name="texto" placeholder="Escreva uma observação (opcional se só anexar)..." rows="2"></textarea>

            <div class="form-obs-acoes">
                <input type="file" name="arquivo" id="input-arquivo-obs" class="input-file-hidden">
                <label for="input-arquivo-obs" class="btn btn-ghost">Anexar arquivo</label>
                <span id="nome-arquivo-obs" class="nome-arquivo">nenhum arquivo</span>
                <button class="btn btn-primary" type="submit">Adicionar</button>
            </div>
        </form>

        <hr class="divisor">

        <% if (observacoes.length===0 && anexos.length===0) { %>
            <p class="vazio-mini">Nenhuma observação ou anexo ainda.</p>
            <% } else { %>
                <ul class="feed">
                    <% const feed=[ ...observacoes.map(o=> ({ ...o, _tipo: 'obs' })),
                        ...anexos.map(a => ({ ...a, _tipo: 'anexo' }))
                        ].sort((a, b) => b.criado_em.localeCompare(a.criado_em));
                        %>

                        <% feed.forEach(item=> { %>
                            <% if (item._tipo==='obs' ) { %>
                                <li class="feed-item feed-obs">
                                    <div class="feed-header">
                                        <strong>
                                            <%= item.autor_nome %>
                                        </strong>
                                        <span class="feed-data">
                                            <%= item.criado_em %>
                                        </span>
                                    </div>
                                    <p class="feed-texto">
                                        <%= item.texto %>
                                    </p>
                                </li>
                                <% } else { %>
                                    <% const ehImagem=item.tipo && item.tipo.startsWith('image/'); const
                                        ehVideo=item.tipo && item.tipo.startsWith('video/'); const
                                        ehPdf=item.tipo==='application/pdf' ; const ehTexto=item.tipo==='text/plain' ;
                                        const podeVisualizar=ehImagem || ehVideo || ehPdf || ehTexto; const
                                        urlVisualizar=`/demandas/anexo/${item.id}/visualizar`; const
                                        urlDownload=`/demandas/anexo/${item.id}/download`; %>
                                        <li class="feed-item feed-anexo">
                                            <div class="feed-header">
                                                <strong>
                                                    <%= item.enviado_por_nome %>
                                                </strong>
                                                <span class="feed-data">
                                                    <%= item.criado_em %>
                                                </span>
                                            </div>
                                            <div class="anexo-linha">
                                                <% if (podeVisualizar) { %>
                                                    <button type="button" class="btn-anexo-nome"
                                                        data-url="<%= urlVisualizar %>"
                                                        data-tipo="<%= ehImagem ? 'imagem' : ehVideo ? 'video' : ehPdf ? 'pdf' : 'texto' %>"
                                                        data-nome="<%= item.nome_original %>">
                                                        <%= item.nome_original %>
                                                    </button>
                                                    <% } else { %>
                                                        <a href="<%= urlDownload %>" class="btn-anexo-nome">
                                                            <%= item.nome_original %>
                                                        </a>
                                                        <% } %>
                                                            <span class="anexo-tamanho">
                                                                <%= (item.tamanho / 1024).toFixed(1) %> KB
                                                            </span>
                                                            <a href="<%= urlDownload %>"
                                                                class="btn btn-small">Baixar</a>
                                                            <% if (usuario.perfil==='supervisor' ) { %>
                                                                <form method="POST"
                                                                    action="/demandas/anexo/<%= item.id %>/excluir"
                                                                    style="display:inline"
                                                                    onsubmit="return confirm('Excluir este anexo?');">
                                                                    <button class="btn btn-small btn-danger"
                                                                        type="submit">Excluir</button>
                                                                </form>
                                                                <% } %>
                                            </div>
                                        </li>
                                        <% } %>
                                            <% }) %>
                </ul>
                <% } %>
    </div>

    <!-- Modal de Histórico -->
    <div id="modal-historico" class="modal">
        <div class="modal-conteudo modal-historico">
            <div class="modal-topbar">
                <span class="modal-nome">Histórico da demanda</span>
                <button type="button" id="modal-historico-fechar" class="btn btn-small btn-danger">Fechar</button>
            </div>
            <div class="modal-body modal-historico-body">
                <% if (historico.length===0) { %>
                    <p class="vazio-mini">Nenhuma atividade registrada ainda.</p>
                    <% } else { %>
                        <ul class="lista-historico">
                            <% historico.forEach(h=> { %>
                                <li class="historico-item">
                                    <span class="historico-hora">
                                        <%= h.criado_em %>
                                    </span>
                                    <span class="atividade-tipo badge-tipo tipo-<%= h.tipo %>">
                                        <%= h.tipo.replace(/_/g, ' ' ) %>
                                    </span>
                                    <span class="historico-desc">
                                        <%= h.descricao || '—' %>
                                    </span>
                                    <span class="historico-user">por <strong>
                                            <%= h.usuario_nome %>
                                        </strong></span>
                                </li>
                                <% }) %>
                        </ul>
                        <% } %>
            </div>
        </div>
    </div>

    <!-- Modal de Visualização de Anexo -->
    <div id="modal-visualizacao" class="modal">
        <div class="modal-conteudo">
            <div class="modal-topbar">
                <span id="modal-nome" class="modal-nome"></span>
                <div class="modal-acoes">
                    <a id="modal-baixar" href="#" class="btn btn-small">Baixar</a>
                    <button type="button" id="modal-fechar" class="btn btn-small btn-danger">Fechar</button>
                </div>
            </div>
            <div id="modal-body" class="modal-body"></div>
        </div>
    </div>

    <script>
        (function () {
            // ===== Modal de Histórico =====
            const modalHist = document.getElementById('modal-historico');
            const btnHist = document.getElementById('btn-historico');
            const btnHistFechar = document.getElementById('modal-historico-fechar');

            btnHist.addEventListener('click', () => {
                modalHist.classList.add('aberto');
                document.body.style.overflow = 'hidden';
            });

            btnHistFechar.addEventListener('click', () => {
                modalHist.classList.remove('aberto');
                document.body.style.overflow = '';
            });

            modalHist.addEventListener('click', (e) => {
                if (e.target === modalHist) {
                    modalHist.classList.remove('aberto');
                    document.body.style.overflow = '';
                }
            });

            // ===== Modal de Visualização =====
            const modal = document.getElementById('modal-visualizacao');
            const modalBody = document.getElementById('modal-body');
            const modalNome = document.getElementById('modal-nome');
            const modalBaixar = document.getElementById('modal-baixar');
            const btnFechar = document.getElementById('modal-fechar');

            function abrirModal(url, tipo, nome) {
                modalNome.textContent = nome || '';
                modalBaixar.href = url.replace('/visualizar', '/download');
                modalBody.innerHTML = '';

                if (tipo === 'imagem') {
                    const img = document.createElement('img');
                    img.src = url;
                    img.alt = nome;
                    modalBody.appendChild(img);
                } else if (tipo === 'video') {
                    const video = document.createElement('video');
                    video.src = url;
                    video.controls = true;
                    video.autoplay = true;
                    modalBody.appendChild(video);
                } else if (tipo === 'pdf' || tipo === 'texto') {
                    const iframe = document.createElement('iframe');
                    iframe.src = url;
                    iframe.title = nome;
                    modalBody.appendChild(iframe);
                }

                modal.classList.add('aberto');
                document.body.style.overflow = 'hidden';
            }

            function fecharModal() {
                modal.classList.remove('aberto');
                modalBody.innerHTML = '';
                document.body.style.overflow = '';
            }

            document.addEventListener('click', (e) => {
                const alvo = e.target.closest('[data-url]');
                if (alvo) {
                    e.preventDefault();
                    abrirModal(
                        alvo.getAttribute('data-url'),
                        alvo.getAttribute('data-tipo'),
                        alvo.getAttribute('data-nome')
                    );
                }
            });

            btnFechar.addEventListener('click', fecharModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) fecharModal();
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    if (modal.classList.contains('aberto')) fecharModal();
                    if (modalHist.classList.contains('aberto')) {
                        modalHist.classList.remove('aberto');
                        document.body.style.overflow = '';
                    }
                }
            });

            // ===== Upload unificado =====
            const inputArquivo = document.getElementById('input-arquivo-obs');
            const nomeArquivo = document.getElementById('nome-arquivo-obs');
            if (inputArquivo) {
                inputArquivo.addEventListener('change', (e) => {
                    nomeArquivo.textContent = e.target.files[0]?.name || 'nenhum arquivo';
                });
            }
        })();
    </script>

    <%- include('../partials/footer') %>